# BlackBull MT5 → Open Trader
# Copy to .env and fill in your BlackBull MT5 credentials

# Path to BlackBull MT5 terminal (Windows) — must be quoted if path has spaces
MT5_PATH="C:\Program Files\BlackBull Markets MT5\terminal64.exe"

# BlackBull account credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=BlackBullMarkets-Live

# Open Trader URL
OPENTRADER_URL=http://127.0.0.1:8010

# Default symbol/timeframe for bridge
MT5_SYMBOL=BTCUSD
MT5_TIMEFRAME=M5

# Auto-sync all symbols on server startup (like old Open Trader) — set 0 to disable
MT5_AUTO_SYNC=1
MT5_SYNC_INTERVAL=60
MT5_SYNC_TIMEFRAMES=M1,M5,H1
