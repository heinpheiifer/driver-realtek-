# Open Trader — NEW unified app (default)
# Copy to .env and edit as needed

# --- BlackBull MT5 (Windows only, same PC as MT5) ---
# MT5_PATH="C:\Program Files\BlackBull Markets MT5\terminal64.exe"
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=BlackBullMarkets-Live
# MT5_AUTO_SYNC=1

# --- Linux: push data from Windows MT5 bridge ---
# OPENTRADER_URL=http://YOUR-LINUX-IP:8010

# --- Legacy old chart UI (off by default — you want the new app) ---
# OPENTRADER_USE_OLD_UI=0
# OPENTRADER_OLD_APP=/home/heinz/opentrade-app

OPENTRADER_URL=http://127.0.0.1:8010
MT5_SYMBOL=BTCUSD
MT5_TIMEFRAME=M5
